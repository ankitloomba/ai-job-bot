generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── Auth ─────────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan          Plan      @default(FREE)
  planExpiresAt DateTime?

  accounts      Account[]
  sessions      Session[]
  resume        Resume?
  preferences   UserPreferences?
  applications  Application[]
  savedJobs     SavedJob[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─── Resume ───────────────────────────────────────────────────────
model Resume {
  id           String   @id @default(cuid())
  userId       String   @unique
  fileName     String
  fileUrl      String
  rawText      String   @db.Text
  parsedData   Json     // skills[], titles[], experience[], education[]
  score        Int      @default(0)
  scoreBreakdown Json?  // per-dimension scores
  embedding    Unsupported("vector(384)")? // sentence-transformers dim
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── User Preferences ─────────────────────────────────────────────
model UserPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  targetRoles    String[]
  locations      String[]
  salaryMin      Int?
  salaryMax      Int?
  workMode       WorkMode @default(ANY)
  experienceYears Int?
  portals        String[] // ["linkedin","naukri","indeed"]
  onboardingDone Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Jobs ─────────────────────────────────────────────────────────
model Job {
  id            String   @id @default(cuid())
  externalId    String   // portal's own job ID
  portal        String   // "linkedin" | "naukri" | "indeed" etc
  title         String
  company       String
  location      String
  workMode      WorkMode @default(ANY)
  salaryMin     Int?
  salaryMax     Int?
  description   String   @db.Text
  applyUrl      String
  tags          String[]
  embedding     Unsupported("vector(384)")? // cached at scrape time
  scrapedAt     DateTime @default(now())
  expiresAt     DateTime?
  isActive      Boolean  @default(true)

  matches       JobMatch[]
  savedBy       SavedJob[]

  @@unique([portal, externalId])
  @@index([portal, isActive, scrapedAt])
}

// ─── Match scores ─────────────────────────────────────────────────
model JobMatch {
  id         String   @id @default(cuid())
  userId     String
  jobId      String
  score      Int      // 0–100
  breakdown  Json?    // per-dimension scores
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([userId, jobId])
  @@index([userId, score(sort: Desc)])
}

// ─── Application tracker ─────────────────────────────────────────
model Application {
  id          String            @id @default(cuid())
  userId      String
  jobTitle    String
  company     String
  portal      String
  applyUrl    String
  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime          @default(now())
  notes       String?           @db.Text
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  savedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([userId, jobId])
}

// ─── Enums ────────────────────────────────────────────────────────
enum Plan {
  FREE
  PRO
  ANNUAL
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  ANY
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}
