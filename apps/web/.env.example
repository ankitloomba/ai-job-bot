# ─── Auth ─────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-here-run-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth (developer.linkedin.com)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Resend for email OTP (resend.com — free 3,000 emails/month)
RESEND_API_KEY=

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/aijobbot

# ─── AI / LLM ─────────────────────────────────────────
# Gemini (free 1M tokens/day) — aistudio.google.com
GEMINI_API_KEY=

# Groq (free 14,400 req/day) — console.groq.com
GROQ_API_KEY=

# Claude Haiku (paid fallback only) — console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Ads ──────────────────────────────────────────────
# Replace XXXXXXXXXXXXXXXX with your real AdSense publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Meta Pixel ID (facebook.com/business/help)
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Payments ─────────────────────────────────────────
# Razorpay (razorpay.com — free account)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Redis (Bull job queue) ───────────────────────────
REDIS_URL=redis://localhost:6379
